.bg-white
  .relative
    %img(src="assets/popcorn/sea.jpg" alt="Olas y arena blanca" style="width:794px;height:300px;object-fit:cover")
    .absolute.bottom-0.left-0.right-0.text-white(style="background:rgba(15,23,42,0.55);padding:18px 40px")
      %p.text-xs.font-semibold.tracking-widest.uppercase {{ kicker }}
      %h1.text-5xl.font-bold {{ title }}

  .grid.grid-cols-2.gap-6(style="padding:28px 40px 0 40px")
    .pr-2
      %h2.text-xl.font-semibold Una playa que parece de mentira
      %p.mt-2.text-sm.leading-relaxed.text-slate-700 {{ intro }}
      %p.mt-3.text-sm.leading-relaxed.text-slate-700 De lejos es una playa blanca; de cerca, un mosaico de pequeñas formas redondeadas que invitan a agacharse y mirar.
      .mt-4.flex.items-center.space-x-2
        %Icon(name="map-pin" size="18px" color="#0f766e")
        %span.text-sm.font-semibold Fuerteventura, Canarias
    %img(src="assets/popcorn/hand.jpg" alt="Una mano con granos blancos y negros" style="width:337px;height:230px;object-fit:cover;border-radius:12px")

  .grid.grid-cols-3.gap-4(style="padding:24px 40px 0 40px")
    - for f in features
      .border.rounded-lg.p-3
        .flex.mb-2
          %Icon(name="{{ f.icon }}" size="26px" color="{{ f.color }}")
        %p.font-semibold {{ f.title }}
        %p.text-xs.text-slate-600.mt-1.leading-relaxed {{ f.text }}

  .relative(style="margin-top:28px")
    %img(src="assets/popcorn/texture.jpg" alt="Detalle de los granos blancos y los cantos negros" style="width:794px;height:150px;object-fit:cover")
    .absolute.bottom-0.left-0.text-white.text-sm.font-semibold(style="background:rgba(15,23,42,0.55);padding:8px 40px") De cerca, cada grano recuerda a una palomita

  .grid.grid-cols-2.gap-2(style="padding:20px 40px 0 40px")
    - for t in tips
      .flex.items-center.space-x-2
        %Icon(name="{{ t.icon }}" size="18px" color="#0f766e")
        %span.text-sm {{ t.text }}
