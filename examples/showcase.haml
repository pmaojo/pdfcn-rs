%DocumentLayout(size="a4")
  %Header(title="{{ product.name }}" subtitle="{{ product.tagline }}")
    %Badge(variant="success" label="{{ product.status }}")

  %img.rounded-2xl.shadow-lg(src="cover.jpg" style="width:100%;height:220px;object-fit:cover;margin-bottom:1rem")

  .grid.grid-cols-3.gap-4.mb-6
    - for stat in stats
      %Card(title="{{ stat.label }}")
        %p.text-2xl.font-bold {{ stat.value }}

  %Card(title="Overview")
    %p {{ product.description }}
    .flex.gap-2.mt-2
      - for tag in product.tags
        %Badge(variant="outline" label="{{ tag }}")

  %Separator

  %h2.text-xl.font-semibold.mb-2 Capabilities

  - for feature in features
    .flex.items-start.gap-2.mb-2.break-inside-avoid
      - if feature.available
        %Badge(variant="success" label="OK")
      - else
        %Badge(variant="destructive" label="Soon")
      .flex-col
        %p.font-medium {{ feature.name }}
        %p.text-sm.text-slate-500 {{ feature.description }}

  %Separator

  %h2.text-xl.font-semibold.mb-2 Gallery

  .grid.grid-cols-3.gap-4.mb-6
    - for photo in gallery
      .flex-col
        %img.rounded.shadow(src="{{ photo.src }}" style="width:100%;height:140px;object-fit:cover")
        %p.text-xs.text-slate-500.mt-1 {{ photo.caption }}

  %Separator

  %h2.text-xl.font-semibold.mb-2 Pricing

  %InvoiceTable(rows={{ pricing.rows }} columns={{ pricing.columns }})

  .flex.justify-between.mt-4.font-bold
    %p Total
    %p {{ pricing.total }}

  .break-before-page

  %Header(title="Team" subtitle="Built by")

  .grid.grid-cols-2.gap-4
    - for member in team
      %Card
        .flex.items-center.gap-4
          %img.rounded-full(src="avatar.jpg" style="width:56px;height:56px;object-fit:cover")
          .flex-col
            %p.font-semibold {{ member.name }}
            %p.text-sm.text-slate-500 {{ member.role }}

  %SignatureBlock(name="{{ product.author }}" label="Approved by")
