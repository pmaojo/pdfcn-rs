%DocumentLayout(size="a4")
  .rounded-2xl.bg-gradient-to-b.from-amber-50.to-white.shadow-xl.ring-4.ring-amber-400(style="padding:14px")
    .rounded-xl.border-2.border-amber-600.text-center(style="padding:48px 36px")
      %p.text-xs.uppercase.tracking-widest.text-amber-700.font-semibold {{ issuer }}
      %p.text-5xl.font-bold.text-slate-900.font-serif(style="margin-top:20px") Certificate
      %p.text-xl.uppercase.tracking-widest.text-amber-700.font-serif(style="margin-top:2px") of {{ kind }}

      .mx-auto.bg-amber-500(style="width:80px;height:3px;margin-top:26px;margin-bottom:26px")

      %p.text-sm.text-slate-500 This certificate is proudly presented to
      %p.text-4xl.font-bold.text-slate-900.italic.font-serif(style="margin-top:14px;margin-bottom:14px") {{ recipient }}
      %p.text-base.text-slate-600.mx-auto(style="width:380px;line-height:1.6") {{ citation }}

      .flex.justify-between.items-center(style="margin-top:44px")
        .flex-col.text-center
          %p.text-lg.font-semibold.text-slate-900.font-serif {{ date }}
          .border-t.border-slate-400(style="margin-top:4px;width:150px")
          %p.text-xs.uppercase.tracking-wider.text-slate-500(style="margin-top:4px") Date
        .rounded-full.bg-gradient-to-br.from-amber-400.to-amber-600.text-white.shadow-lg.flex.items-center.justify-center(style="width:84px;height:84px")
          %p.text-3xl.font-bold ★
        .flex-col.text-center
          %p.text-lg.font-semibold.text-slate-900.italic.font-serif {{ signer }}
          .border-t.border-slate-400(style="margin-top:4px;width:150px")
          %p.text-xs.uppercase.tracking-wider.text-slate-500(style="margin-top:4px") {{ signer_title }}

      .flex.justify-center(style="margin-top:26px")
        %div(class="border-2 border-red-600 text-red-600 rounded text-xs font-bold uppercase tracking-widest -rotate-6" style="padding:4px 14px") Verified

      %p.text-xs.text-slate-400(style="margin-top:34px") Credential ID {{ credential }}
