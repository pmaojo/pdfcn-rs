%DocumentLayout(size="a4")
  %Header(title="{{ store.name }}" subtitle="{{ store.tagline }}")

  .grid.grid-cols-2
    - for product in products
      %Card(title="{{ product.name }}" image="{{ product.image }}" image-alt="{{ product.name }}" class="m-2")
        - if product.discount
          .absolute.top-2.right-2.z-10.rounded-full.bg-destructive.text-white.text-xs.font-semibold(style="padding:2px 10px") {{ product.discount }}
        %p.text-sm.text-slate-500.mb-2 {{ product.description }}
        .flex.justify-between.items-center.mt-2
          %p.text-lg.font-bold {{ product.price }}
          .rounded-full.border.border-input.text-foreground.text-xs.font-semibold(style="padding:2px 10px;display:inline-block") In stock
